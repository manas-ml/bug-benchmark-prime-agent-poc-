__pycache__/
*.pyc
.pytest_cache/

# Real run output (raw session exports, meta, CSVs, charts) is generated by
# the runners/scoring/analysis scripts, not committed. Directory structure is
# preserved via .gitkeep.
/results/condition_a/*
/results/condition_b/*
!/results/condition_a/.gitkeep
!/results/condition_b/.gitkeep
/results/aggregate.csv
/results/*.png
